!**/.env.example

# Local overrides
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Databases & Local Storage ---
*.sqlite3
*.db
*.sqlite
*.sql.gz

# --- Runtime Media Uploads ---
# Ignore user-uploaded runtime audio files, but keep directory structure
songs/*
!songs/.gitkeep

# Continuous learning runtime recordings
recognition-service/continuous_learning/*
!recognition-service/continuous_learning/.gitkeep

# --- Datasets & Raw Archive Data ---
IRMAS*
IRMAS-TrainingData/
IRMAS-TestingData/
dataset/
datasets/
archive/
data/openmic-2018/
data/IRMAS-TrainingData/
data/processed/
*.tar.gz
*.tar
*.zip
*.7z
*.rar

# --- Training artifacts & Heavy Checkpoints ---
# Keep default pre-trained instrument models in recognition-service/models/
# but ignore training logs, wandb, tensorboard, checkpoints
checkpoints/
runs/
wandb/
.tensorboard/
*.ckpt

