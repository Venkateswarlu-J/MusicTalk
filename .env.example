# ==============================================================================
# MusicTalk — Global Environment Configuration Example
# Copy this file to .env or configure your environment variables accordingly.
# ==============================================================================

# --- Database Settings (Catalog Service) ---
DB_USER=root
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=3306
DB_NAME=musictalk_catalog

# Optional direct database connection string (overrides above fields if set):
# DATABASE_URL=mysql+aiomysql://root:root@localhost:3306/musictalk_catalog?charset=utf8mb4

# --- Microservice URLs (API Gateway Routing) ---
RECOGNITION_SERVICE_URL=http://localhost:8000
CATALOG_SERVICE_URL=http://localhost:8001
RECOMMENDATION_SERVICE_URL=http://localhost:8002

# --- Storage Settings ---
# Directory where uploaded audio tracks are stored (defaults to /songs in project root)
# SONGS_DIR=./songs
